  "executive_highlights": {
    "Inter Miami CF": {
      "snapshot": "Commercial gravity is unmatched; app stack is serviceable but under-leverages the Messi halo for personalization and sponsor value.",
      "strengths": [
        "High-volume demand engine (Messi, global traffic) already feeding content and ticket flows.",
        "Concessions ordering sorted (Grubhub) → strong baseline convenience.",
        "Apple Season Pass creates premium content funnel to tap."
      ],
      "gaps": [
        "Limited evidence of loyalty mechanics beyond league-wide Sorare.",
        "Ingress + in-venue innovation (biometrics, JWO/Mashgin) not visible.",
        "Sponsor interactivity inside the app is thin (logos > activations)."
      ],
      "yinzcam_pitch_plays": [
        "“Messi Moments” personalized hub with sponsor wallet tie-ins based on watch-time thresholds.",
        "In-Venue Mode at DRV PNK with geofenced tiles for queues, seat offers, and post-goal flash rewards.",
        "Live Activities + micro-predictors for marquee matches → sponsored micro-rewards.",
        "Progressive EN/ES onboarding to drive targeted upsell to ticket packs and partner offers."
      ]
    },
    "Orlando City SC": {
      "snapshot": "Early mover on fan CRM; momentum has plateaued. Big upside in modernizing membership and making sponsors measurable.",
      "strengths": [
        "FanThreeSixty heritage → CRM mindset and a base for membership thinking.",
        "Solid matchday information architecture (ticketing, schedules, basics are covered).",
        "Local supporter culture that can be productized."
      ],
      "gaps": [
        "Loyalty feels static; little gamification or tier progression cues.",
        "Sparse sponsor activations embedded in core journeys (checkout, check-ins, content).",
        "Limited EN/ES personalization surfacing in-app."
      ],
      "yinzcam_pitch_plays": [
        "LionNation 2.0 tiers + mission-based challenges with visible progression.",
        "Supporter Groups module with watch-party map and sponsored community badges.",
        "Offer Wallet + Receipt Ads to link POS partners and prove sponsor ROI with closed-loop metrics.",
        "EN/ES preference center with segmented push cadences and content rails."
      ]
    },
    "Atlanta United": {
      "snapshot": "Stadium tech is elite; the app under-monetizes that infrastructure. Bridge MBS’s capabilities into personalized mobile flows.",
      "strengths": [
        "Best-in-class venue stack (cashless, connectivity, parking orchestration).",
        "Huge, energetic matchday base; top-quartile attendance, strong supporter culture.",
        "Content flywheel aided by Apple Season Pass."
      ],
      "gaps": [
        "Personalization + loyalty don’t reflect the sophistication of MBS systems.",
        "Ingress & queue intelligence not surfaced as fan-visible utilities inside the app.",
        "Sponsors are not woven into in-the-moment interactions."
      ],
      "yinzcam_pitch_plays": [
        "MBS In-Venue Mode: gate-specific guidance, restroom/stand wait-time cards, smart nudges tied to seat & half-time windows.",
        "Parking to Seat Journey: ParkMobile/ParkHub → single trip timeline with sponsored “time saved” insights.",
        "Matchday Missions (check-in + predictor + post-win photo) bundled into tier points and partner rewards.",
        "Dynamic Offer Engine: geofenced, inventory-aware F&B/merch offers; Live Activities for “order ready” pickup."
      ]
    },
    "San Jose Earthquakes": {
      "snapshot": "Understated digital footprint; clean runway to stand up a modern app stack quickly and show sponsor impact.",
      "strengths": [
        "Ticketmaster baseline; parking partner (Propark) simplifies mobility ops.",
        "Loyal local fan community; family-friendly matchday lends itself to missions."
      ],
      "gaps": [
        "No signature feature (loyalty, predictors, AR) that fans identify with.",
        "Low in-venue utility (queues, maps, service alerts) surfaced to fans.",
        "Sparse sponsor interactivity beyond branding."
      ],
      "yinzcam_pitch_plays": [
        "Quakes Passport: family-friendly missions unlocking concessions/merch.",
        "Service Utilities: wait-time cards and section-aware service alerts; sponsor the helpful utility.",
        "Supporter & Community hub with youth/academy content + local partner offers.",
        "Progressive EN/ES onboarding with player affinities for targeted pushes."
      ]
    },
    "Nashville SC": {
      "snapshot": "Strong base app; time to lean into personalization and measurable sponsor value.",
      "strengths": [
        "YinzCam core already in place (reliable content, push, loyalty primitives).",
        "High-engagement match atmosphere at GEODIS Park."
      ],
      "gaps": [
        "Tier design and visible progress can be richer (badges, milestones, perks).",
        "Limited contextual offers (pre-match, halftime, exit) tied to behavior."
      ],
      "yinzcam_pitch_plays": [
        "Personalized Feed + Missions with music-themed badges and section check-ins.",
        "In-Venue Mode with predictive “best time to order” prompts; sponsored express lane nudges.",
        "Post-match Recaps with auto-clips and “you were there” highlights → redeemable offers.",
        "Supporter Group rails and affiliate deals for SG members."
      ]
    },
    "New York Red Bulls": {
      "snapshot": "Robust signage backbone at Red Bull Arena; opportunity is to synchronize app moments with screens and sponsor inventory.",
      "strengths": [
        "Cisco StadiumVision + Daktronics for high-impact concourse messaging.",
        "Established YinzCam app as a reliable delivery channel."
      ],
      "gaps": [
        "Two disconnected canvases (app vs. signage) limit 1+1=3 impact.",
        "Loyalty structure can feel invisible to casual fans."
      ],
      "yinzcam_pitch_plays": [
        "Second-Screen x Signage Sync: goal events trigger in-app coupons while boards display claim codes.",
        "RBNY Rewards 2.0: public tier names, predictable earn ladders, limited-time boosts.",
        "Transit-aware Push (EN/ES): pre and post-match guidance with partner offers.",
        "Seat-Upgrade Carousel: dynamic micro-upsells during lulls."
      ]
    },
    "LA Galaxy": {
      "snapshot": "Global brand with deep heritage; the app can become the narrative home, not just utilities.",
      "strengths": [
        "Massive legacy content well; international following.",
        "Solid YinzCam baseline for content and notifications."
      ],
      "gaps": [
        "Underdeveloped personalization for international segments (language, player affinity).",
        "Few interactive hooks (predictors, AR) visible around marquee fixtures."
      ],
      "yinzcam_pitch_plays": [
        "Legends Hub: eras, icons, fan-voted moments → sponsored Story of the Match.",
        "Global Personalization: EN/ES rails + time-zone-aware plans and recap pushes.",
        "Derby Day Predictors + Badges with unlockable merch/partner offers.",
        "AR First-Kick overlays; brandable frames that measure share reach."
      ]
    },
    "Colorado Rapids": {
      "snapshot": "Community-centric club; big upside in visible loyalty and in-venue convenience as reasons to open the app.",
      "strengths": [
        "Reliable YinzCam stack; family-forward audience profile.",
        "Ticketing and content baselines are dependable."
      ],
      "gaps": [
        "Earn→Burn clarity for loyalty is low (fans don’t know what to do next).",
        "In-venue guidance (queues, best time to order) not front-and-center."
      ],
      "yinzcam_pitch_plays": [
        "Rapids Rewards with public ladders and guaranteed perks per tier.",
        "Concessions Smart Prompts with Live Activities for pickup.",
        "Community Days surfaced in app with local partner bundles.",
        "Weather-aware matchday push kit with sponsored comfort packs."
      ]
    }
  }
